/* NEKOPINK THEME (NekoBox++) */
/* Inspired by desserts like macarons and cupcakes - Soft pinks, mint greens, lavender, and cream with subtle darker accents. */

QMainWindow {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #FCE4EC, stop: 0.3 #FFE4EE,
                                stop: 0.7 #FFF0F5, stop: 1 #F8BBD0);
    color: #40222E;
    border: none;
}

QWidget {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #FCE4EC, stop: 0.3 #FFE4EE,
                                stop: 0.7 #FFF0F5, stop: 1 #F8BBD0);
    color: #40222E;
}

QPushButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #FFCDD2, stop: 1 #F48FB1);
    border: 2px solid #D81B60;
    border-radius: 10px;
    padding: 10px 15px;
    color: #FFFFFF;
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #F8BBD0, stop: 1 #FFCDD2);
    border: 2px solid #D81B60;
}

QPushButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #F48FB1, stop: 1 #FFCDD2);
    border: 2px inset #D81B60;
}

QPushButton:disabled {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #B0BEC5, stop: 1 #90A4AE);
    border: 2px solid #78909C;
    color: #CFD8DC;
}

QTextEdit, QPlainTextEdit {
    background: #FFFFFF;
    border: 2px solid #F06292;
    border-radius: 5px;
    padding: 8px;
    color: #40222E;
    selection-background-color: #F48FB1;
    selection-color: #FFFFFF;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #D81B60;
}

QListWidget {
    background: #FFFFFF;
    border: 2px solid #F06292;
    border-radius: 5px;
    alternate-background-color: #FCE4EC;
    color: #40222E;
    gridline-color: #F8BBD0;
    outline: none;
}

QListWidget::item {
    padding: 8px 10px;
    color: #40222E;
    border-bottom: 1px solid #FFF0F5;
}

QListWidget::item:selected {
    background: #F48FB1;
    color: #FFFFFF;
}

QListWidget::item:hover {
    background: #FCE4EC;
}

QMenuBar {
    background: #F8BBD0;
    color: #40222E;
    border-bottom: 1px solid #F48FB1;
}

QMenuBar::item {
    background: transparent;
    color: #40222E;
    padding: 5px 10px;
}

QMenuBar::item:selected {
    background: #F48FB1;
}

QMenu {
    background: #F8BBD0;
    border: 1px solid #F48FB1;
    padding: 5px;
}

QMenu::item {
    padding: 5px 15px;
    color: #40222E;
}

QMenu::item:selected {
    background: #F48FB1;
}

QScrollBar:vertical {
    background: #F8BBD0;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #F48FB1;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #F8BBD0;
    height: 12px;
    border-radius: 6px;
}/* TABLE VIEW */
QTableView {
    background: #FFFFFF;
    alternate-background-color: #FCE4EC;
    border: 2px solid #F06292;
    border-radius: 5px;
    gridline-color: #F8BBD0;
    color: #40222E;
    selection-background-color: #F48FB1;
    selection-color: #FFFFFF;
}

/* VIEWPORT (important for Qt tables) */
QTableView::viewport {
    background: #FFFFFF;
}

/* TABLE CELLS */
QTableView::item {
    padding: 6px;
    border-bottom: 1px solid #FFF0F5;
    color: #40222E;
}

/* HOVER ROW */
QTableView::item:hover {
    background: #FCE4EC;
}

/* SELECTED CELL */
QTableView::item:selected {
    background: #F48FB1;
    color: #FFFFFF;
}

/* HEADERS */
QHeaderView::section {
    background: #F8BBD0;
    color: #40222E;
    border: 1px solid #F48FB1;
    padding: 6px;
}

/* HEADER HOVER */
QHeaderView::section:hover {
    background: #FFF0F5;
}

/* CORNER BUTTON */
QTableCornerButton::section {
    background: #F8BBD0;
    border: 1px solid #F48FB1;
}

/* REMOVE FOCUS BORDER */
QTableView {
    outline: none;
}
QTableView {
    gridline-color: #F8BBD0;
}

QScrollBar::handle:horizontal {
    background: #F48FB1;
    border-radius: 5px;
}

QTabWidget::pane {
    border: 1px solid #F48FB1;
    background: #FFFFFF;
}

QTabBar::tab {
    background: #F8BBD0;
    border: 1px solid #F48FB1;
    padding: 8px 15px;
    color: #40222E;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #40222E;
}

QTabBar::tab:hover:!selected {
    background: #FFF0F5;
}

QStatusBar {
    background: #F8BBD0;
    border-top: 1px solid #F48FB1;
    color: #40222E;
}

QLineEdit {
    background: #FFFFFF;
    border: 2px solid #F06292;
    border-radius: 5px;
    padding: 8px;
    color: #40222E;
    selection-background-color: #F48FB1;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #D81B60;
}

QComboBox {
    background: #F8BBD0;
    border: 2px solid #F48FB1;
    border-radius: 5px;
    padding: 5px;
    color: #40222E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #F48FB1;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 8px solid #40222E;
}

QComboBox QAbstractItemView {
    background: #F8BBD0;
    border: 1px solid #F48FB1;
    selection-background-color: #F48FB1;
    color: #40222E;
}

QSplitter::handle {
    background: #F48FB1;
    border: 1px solid #40222E;
}

QSplitter::handle:horizontal {
    width: 5px;
}

QSplitter::handle:vertical {
    height: 5px;
}

QProgressBar {
    border: 2px solid #F06292;
    border-radius: 5px;
    background: #FFFFFF;
    text-align: center;
    color: #40222E;
}

QProgressBar::chunk {
    background: #F48FB1;
    border-radius: 3px;
}

QToolTip {
    background: #F8BBD0;
    border: 1px solid #F48FB1;
    color: #40222E;
    padding: 5px;
    border-radius: 3px;
}

QLabel {
    color: #40222E;
}

QGroupBox {
    border: 2px solid #F48FB1;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    color: #40222E;
    background: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    background: #F48FB1;
    color: #FFFFFF;
    border-radius: 3px;
}

QCheckBox {
    color: #40222E;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1px solid #F06292;
    background: #FFFFFF;
}

QCheckBox::indicator:checked {
    background: #F48FB1;
}

/* NekoBox++ shell: group tabs as pink pills */
QTabWidget::pane {
    border: none;
    background: #FFFFFF;
}

QTabWidget::pane {
    border: none;
    background: #FFFFFF;
}

QTabWidget {
    background: #FFFFFF;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: #FDE7F0;
    color: #374151;
    border: none;
    border-radius: 10px;
    padding: 7px 20px;
    margin: 6px 8px 6px 0;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #F06292;
    color: #FFFFFF;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #FBDCE9;
}
